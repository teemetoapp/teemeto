# Database
# App connection (uses non-superuser teemeto_app for strict RLS enforcement)
DATABASE_URL=postgresql+asyncpg://teemeto_app:teemeto_app_pass@localhost:5432/teemeto_db
# Admin/migration connection (for schema DDL and migrations)
DATABASE_ADMIN_URL=postgresql+asyncpg://teemeto_user:teemeto_pass@localhost:5432/teemeto_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot (for testing / tenant bot connection)
TELEGRAM_BOT_TOKEN=your_test_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Clerk Auth
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...

# AI / LLM Providers
OPENAI_API_KEY=sk-...

# Application
ENVIRONMENT=local
LOG_LEVEL=INFO
